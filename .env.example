# =============================================================================
# cleom-ui-platform — Environment Variables
# Copy to .env.local (gitignored) and fill in real values.
# =============================================================================

# Supabase project
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# App origin — usado para emailRedirectTo en signup, redirectTo en password
# recovery, y para validar que coincide con el "Site URL" / "Redirect URLs"
# configurado en el dashboard Supabase (Authentication → URL Configuration).
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Auth callback paths (relativos a NEXT_PUBLIC_APP_URL).
# Si los cambias en código, también deben actualizarse en Supabase dashboard.
NEXT_PUBLIC_AUTH_CALLBACK_PATH=/auth/callback
NEXT_PUBLIC_AUTH_RECOVERY_REDIRECT_PATH=/auth/update-password
